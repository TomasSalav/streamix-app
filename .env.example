# Streamix Environment Variables
# =============================================================================
# Copia este archivo a .env y cambia los valores según tu entorno
# =============================================================================

# =============================================================================
# SERVIDOR (Flask)
# =============================================================================

# Clave secreta para firmar tokens JWT (cambia en producción)
SECRET_KEY=streamix-secret-key-dev-2026

# Nombre del módulo de la app Flask
FLASK_APP=run.py

# Entorno: development o production
FLASK_ENV=development

# =============================================================================
# BASE DE DATOS (PostgreSQL)
# =============================================================================

# Usuario de la base de datos
DB_USER=streamix_user

# Contraseña de la base de datos
DB_PASSWORD=streamix_password

# Host de la base de datos:
DB_HOST=db

# Puerto de la base de datos:
DB_PORT=5432

# Nombre de la base de datos
DB_NAME=streamix

# =============================================================================
# CLIENTE (React/Vite)
# =============================================================================

# URL del API:
#   - Usar 'http://localhost:5050/api' para desarrollo local
#   - Usar 'http://server:5050/api' cuando se usa docker-compose
VITE_API_URL=http://localhost:5050/api
